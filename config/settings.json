{
  "model": "gpt-5.4-nano",
  "workspace": "./workspace",
  "mode": "build",
  "maxSteps": 60,
  "requestTimeoutMs": 120000,
  "retry": {
    "retries": 3,
    "baseDelayMs": 1000,
    "maxDelayMs": 15000
  },
  "search": {
    "providers": [
      "searxng",
      "duckduckgo",
      "wikipedia"
    ],
    "searxngUrls": [
      "https://searx.be",
      "https://search.inetol.net",
      "https://priv.au",
      "https://searx.tiekoetter.com"
    ],
    "searxngEngines": "",
    "maxResults": 8,
    "timeoutMs": 10000,
    "fetchTimeoutMs": 20000
  },
  "limits": {
    "maxReadBytes": 200000,
    "maxToolResultChars": 10000,
    "commandTimeoutMs": 60000,
    "maxCommandOutputChars": 20000,
    "readChunkLines": 250
  },
  "approvals": {
    "createFile": false,
    "overwriteFile": true,
    "editFile": false,
    "deleteFile": true,
    "moveFile": true,
    "createDirectory": false,
    "runCommand": true,
    "openPath": true
  },
  "optimization": {
    "dynamicTools": true,
    "stickyTools": true,
    "parallelTools": true,
    "keepRecentToolResults": 4,
    "compressedToolResultChars": 500,
    "compressTriggerChars": 8000
  },
  "security": {
    "outsideWorkspace": "ask"
  },
  "rules": {
    "allowCommands": [
      "git status*",
      "git diff*",
      "git log*",
      "git branch*",
      "npm test*",
      "npm run test*",
      "node --check *"
    ],
    "denyCommands": [
      "git push*",
      "git reset --hard*",
      "git clean*",
      "npm publish*"
    ]
  },
  "hooks": {},
  "mcpServers": {},
  "context": {
    "compactAtChars": 120000,
    "keepTurns": 2,
    "summarizer": "local",
    "manualSummarizer": "model",
    "maxTokens": 32000
  },
  "planning": {
    "enabled": true,
    "taskFrame": true,
    "budgets": {
      "simple": 8,
      "moderate": 20
    },
    "subagentMaxSteps": 20
  },
  "tools": {
    "protocol": "auto"
  },
  "cache": {
    "enabled": true,
    "files": {
      "maxEntries": 400,
      "maxMB": 24
    },
    "tools": {
      "maxEntries": 300,
      "maxMB": 8,
      "webTtlMs": 600000
    },
    "model": {
      "maxEntries": 100,
      "maxMB": 4
    }
  },
  "audit": {
    "enabled": true
  },
  "ui": {
    "rtl": "auto",
    "statusBar": true,
    "showPhases": true,
    "codeHighlight": true
  },
  "models": {
    "simple": null,
    "summary": null,
    "subagent": null
  },
  "tokens": {
    "maxOutput": null,
    "summary": 700,
    "subagent": null
  }
}
