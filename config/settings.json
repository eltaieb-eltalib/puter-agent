{
  "model": "gpt-5.4-nano",
  "workspace": "./workspace",
  "mode": "build",
  "maxSteps": 60,
  "requestTimeoutMs": 120000,
  "retry": {
    "retries": 3,
    "baseDelayMs": 1000,
    "maxDelayMs": 15000
  },
  "search": {
    "providers": [
      "searxng",
      "duckduckgo",
      "wikipedia"
    ],
    "searxngUrls": [
      "https://searx.be",
      "https://search.inetol.net",
      "https://priv.au",
      "https://searx.tiekoetter.com"
    ],
    "searxngEngines": "",
    "maxResults": 8,
    "timeoutMs": 10000,
    "fetchTimeoutMs": 20000
  },
  "limits": {
    "maxReadBytes": 200000,
    "maxToolResultChars": 10000,
    "commandTimeoutMs": 60000,
    "maxCommandOutputChars": 20000
  },
  "approvals": {
    "createFile": false,
    "overwriteFile": true,
    "editFile": false,
    "deleteFile": true,
    "moveFile": true,
    "createDirectory": false,
    "runCommand": true,
    "openPath": true
  },
  "optimization": {
    "dynamicTools": true,
    "keepRecentToolResults": 4,
    "compressedToolResultChars": 1200
  },
  "security": {
    "outsideWorkspace": "ask"
  },
  "rules": {
    "allowCommands": [
      "git status*",
      "git diff*",
      "git log*",
      "git branch*",
      "npm test*",
      "npm run test*",
      "node --check *"
    ],
    "denyCommands": [
      "git push*",
      "git reset --hard*",
      "git clean*",
      "npm publish*"
    ]
  },
  "hooks": {},
  "mcpServers": {}
}