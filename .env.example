# Copy this file to ".env" (same folder) and fill in your values.
# NEVER commit the real .env file.

# Optional. Create a token at https://puter.com/dashboard ("Create token").
# If empty, a browser window opens for sign-in every time you start the agent.
PUTER_AUTH_TOKEN=

# Optional. Overrides "workspace" from config/settings.json (absolute path, or relative to the current folder).
# Example (Windows): PUTER_AGENT_WORKSPACE=F:\AI-Projects
PUTER_AGENT_WORKSPACE=

# Optional. Your own SearXNG instance (tried first for web_search), e.g. http://localhost:8080
# Public instances are used as a fallback, then DuckDuckGo, then Wikipedia.
SEARXNG_URL=

# Optional. Gemini (Google AI) API key
# Get from Google AI Studio.
GEMINI_API_KEY=

# Optional. OpenAI API key (official OpenAI SDK + Responses API)
# Create a key in the OpenAI API platform.
OPENAI_API_KEY=

# Optional. OpenAI reasoning effort: none | minimal | low | medium | high | xhigh | max.
# The selected model determines which values are accepted.
OPENAI_REASONING_EFFORT=medium

# Optional. GPT-5.6 / GPT-6 Responses API reasoning mode: standard | pro.
OPENAI_REASONING_MODE=standard

# Optional. Compatible API gateway URL (leave blank for api.openai.com).
OPENAI_BASE_URL=

# Optional. AgentRouter API key (Responses API at https://agentrouter.org/v1/responses).
AGENTROUTER_API_KEY=

# Optional. Which backend to use: puter (default), gemini, openai or agentrouter. /connect inside the app also saves this.
AGENT_PROVIDER=

# Optional. Only for proxies or tests: replaces https://generativelanguage.googleapis.com
GEMINI_BASE_URL=

# Optional. Gemini 3+ thinking: low (default, fast) | medium | high (slow) | off (provider default).
GEMINI_THINKING_LEVEL=

# Additional providers (fill only the provider(s) you use).
ANTHROPIC_API_KEY=
ANYAPI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_API_KEY=
PERPLEXITY_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
# Optional; Ollama and LM Studio default to local endpoints and do not require keys.
OLLAMA_API_KEY=
LMSTUDIO_API_KEY=
